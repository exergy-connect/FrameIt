{
  "manifest_version": 3,
  "name": "Exergy ∞ FrameIt",
  "version": "1.0.0",
  "description": "Capture an MP4 of your current web session with a brief countdown and session bar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Exergy ∞ FrameIt",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/favicon.svg",
        "assets/favicon.ico",
        "assets/exergy_connect_logo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
