{
  "manifest_version": 3,
  "name": "Exergy ∞ Frame",
  "version": "1.0.0",
  "description": "Exergy ∞ Frame captures the context around your digital experience. Record your current web session as an audio and video MP4 with a brief countdown and simple recording controls.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Exergy ∞ Frame",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/favicon.svg",
        "assets/favicon.ico",
        "assets/exergy_connect_logo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
